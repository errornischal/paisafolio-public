# ════════ PAISAFOLIO, SERVER ENVIRONMENT ════════
#
# These are set on your host, not in this file. On Vercel:
#   Project → Settings → Environment Variables → add each one →
#   apply to Production and Preview → redeploy.
#
# Nothing here ever reaches the browser. The values the browser IS allowed to
# see live in sb-config.js instead.
#
# Every one of these is optional. With none of them set, the app runs on the
# device with live prices and no assistant.


# ── Supabase, for the server side ────────────────────────────────────────
# Only needed if you want the assistant or the admin page. Accounts and sync
# need sb-config.js, not these.
#
# Settings → API in your Supabase project.
SUPABASE_URL=https://your-project.supabase.co

# Settings → API → service_role. This one bypasses row level security, so it
# belongs here and NOWHERE in the app files. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=

# Some hosts inject these instead; either naming works.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_ANON_KEY=


# ── The assistant ────────────────────────────────────────────────────────
# Set at least one and the Assistant button comes alive. Set several and it
# spreads requests across them, so one provider running out of quota is not
# the whole feature going down. All of these have a free tier.
#
# Once the admin page is up you can manage these there instead, stored in the
# database rather than here, which means changing a key does not need a
# redeploy. Environment variables still work and are the simpler start.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=


# ── Nepal share prices (optional) ────────────────────────────────────────
# Only if you track NEPSE-listed shares. Without these, NEPSE prices are the
# ones you type in yourself; everything else (crypto, metals, currencies)
# works with no configuration at all.
NEPSE_API_URL=
NEPSE_SCRAPE_URL=


# ── Locking down the API routes (optional) ───────────────────────────────
# A comma-separated list of origins allowed to call api/. Leave it empty and
# the routes answer same-origin requests, which is what you want unless you
# are serving the app from a different domain than the functions.
# ALLOWED_ORIGINS=https://your-app.vercel.app
